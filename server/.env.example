# ── Pamildori backend env ─────────────────────────────────────────────
# Telegram bot token from @BotFather (KEEP SECRET — never commit the real one)
BOT_TOKEN=123456:replace-with-your-bot-token

# Public hostname the Mini App will call. Domain is on Cloudflare (DNS only):
# add an A record  api -> <VPS IP>  (grey cloud) so Caddy can issue the cert.
PUBLIC_HOST=api.pamildori.uz
PUBLIC_BASE_URL=https://api.pamildori.uz

# Origin(s) of the Mini App frontend allowed to call the API (CORS), comma-sep.
# Add https://pamildori.uz too if you later serve the frontend on the apex.
ALLOWED_ORIGINS=https://zay1d.github.io

# Server bind (behind Caddy). In docker-compose HOST is forced to 0.0.0.0.
PORT=8080
HOST=127.0.0.1
DATA_DIR=./data

# Limits / lifetimes
MAX_AUDIO_MB=20
INITDATA_MAX_AGE_SEC=86400
STREAM_TTL_SEC=21600

# RECOMMENDED in production: an explicit random secret for stream tokens, so the
# streaming key is decoupled from the bot token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset it is derived from BOT_TOKEN.
# STREAM_SECRET=
