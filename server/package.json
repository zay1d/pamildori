{
  "name": "pamildori-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pamildori playlist backend — Telegram bot (long polling) + HTTP API",
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "dev": "node --experimental-strip-types --watch src/server.ts",
